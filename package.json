{
  "name": "local-jev-mario",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.3.0",
  "engines": { "node": ">=24" },
  "scripts": {
    "start": "node --network-family-autoselection-attempt-timeout=2000 server.mjs",
    "jev": "node local-jev.mjs",
    "model": ".venv/bin/python local_this_that.py",
    "download:model": ".venv/bin/python download_model.py",
    "test:python": ".venv/bin/python -m unittest discover -s tests -p 'test_*.py'",
    "test": "node --test tests/*.test.mjs",
    "lint": "biome check . --no-errors-on-unmatched",
    "probe": "node probe.mjs",
    "smoke": "node smoke.mjs"
  },
  "dependencies": { "jsnes": "2.1.0" },
  "devDependencies": { "@biomejs/biome": "1.9.4" }
}
