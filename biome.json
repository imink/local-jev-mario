{
  "$schema": "https://biomejs.dev/schemas/1.9.4/schema.json",
  "organizeImports": { "enabled": true },
  "files": {
    "ignore": [
      "node_modules/**",
      "midscene_run/**",
      ".venv/**",
      "models/**",
      ".cache/**"
    ]
  },
  "javascript": { "formatter": { "quoteStyle": "single" } },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "style": { "noParameterAssign": "off", "noUselessElse": "off" },
      "complexity": { "noForEach": "off" },
      "suspicious": { "noImplicitAnyLet": "off" }
    }
  },
  "formatter": {
    "lineWidth": 80,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineEnding": "lf"
  }
}
